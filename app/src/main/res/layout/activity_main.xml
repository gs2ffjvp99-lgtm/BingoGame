<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml (start screen)
    ScrollView lets the content move up when the keyboard opens on small phones.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Game title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/title_bingo"
            android:textColor="@color/primary"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/subtitle_bingo"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <!-- Username input (saved with every Bingo record) -->
        <EditText
            android:id="@+id/edit_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="@string/hint_username"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:maxLength="20"
            android:maxLines="1"
            android:textColor="@color/text_primary" />

        <!-- Main action -->
        <Button
            android:id="@+id/button_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/primary"
            android:text="@string/button_start"
            android:textColor="@color/text_on_color" />

        <!-- Secondary action -->
        <Button
            android:id="@+id/button_view_records"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/button_view_records" />

        <!-- Short rules for first-time players -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/rules"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
