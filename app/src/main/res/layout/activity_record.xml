<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_record.xml (records screen)
    The ListView and the empty message share the same space: ListView
    hides itself and shows text_empty when there are no rows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- "Saved records: N" -->
    <TextView
        android:id="@+id/text_record_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- One row per Bingo record (newest first) -->
    <ListView
        android:id="@+id/list_records"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@color/cell_empty" />

    <!-- Shown instead of the list when the table is empty -->
    <TextView
        android:id="@+id/text_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/empty_records"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/button_clear_records"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/button_clear_records" />
</LinearLayout>
